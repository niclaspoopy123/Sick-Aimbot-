--// Main Loop

local rainbowHue = 0

RunService.RenderStepped:Connect(function(dt)
    -- Rainbow highlight cycle
    if rainbowMode then
        rainbowHue = (rainbowHue + dt * 0.3) % 1
        local col = hsvToColor(rainbowHue)
        for _, hl in pairs(playerHighlights) do
            hl.FillColor = col
        end
    end

    -- ESP update (distance + health)
    if espEnabled then
        local lc = LocalPlayer.Character
        local lr = lc and (lc.PrimaryPart or lc:FindFirstChild("HumanoidRootPart"))
        for player, esp in pairs(playerESP) do
            if not esp or not esp.bill or not esp.bill.Parent then continue end
            local char = player.Character
            if not char then continue end
            local root = char.PrimaryPart or char:FindFirstChild("HumanoidRootPart")
            local hum  = char:FindFirstChildOfClass("Humanoid")
            if root and lr then
                local dist = math.floor((root.Position - lr.Position).Magnitude)
                esp.distLbl.Text = dist .. " studs"
            end
            if hum then
                local pct = math.clamp(hum.Health / math.max(hum.MaxHealth,1), 0, 1)
                esp.hpFill.Size = UDim2.new(pct, 0, 1, 0)
                -- Color green -> yellow -> red
                esp.hpFill.BackgroundColor3 = Color3.fromRGB(
                    math.floor(255*(1-pct)), math.floor(255*pct), 0)
            end
        end
    end

    -- 360° radar
    scan360()

    -- Aimbot (active when enabled AND aim key held, or just enabled if AIM_KEY is handled separately)
    local shouldAim = aimbotEnabled and aimKeyHeld
    if shouldAim and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
        local targetPart, targetScore = getTarget()
        if targetPart then
            -- Update target memory
            if previousTarget and previousTarget ~= targetPart then
                if targetScore < previousTargetScore * CONFIG.TARGET_SWITCH_THRESHOLD then
                    previousTarget      = targetPart.Parent
                    previousTargetScore = targetScore
                end
            else
                previousTarget      = targetPart.Parent
                previousTargetScore = targetScore
            end

            local predictedPos = targetPart.Position
            local char       = targetPart.Parent
            local targetRoot = char and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))

            -- Enhanced Kalman prediction with acceleration
            if CONFIG.PREDICTION_ENABLED and targetRoot and targetRoot:IsA("BasePart") then
                local lc   = LocalPlayer.Character
                local lr   = lc and (lc.PrimaryPart or lc:FindFirstChild("HumanoidRootPart"))
                local mVel = targetRoot.Velocity
                local state = targetKalman[targetRoot]
                if not state then
                    state = {
                        velocity    = mVel,
                        acceleration= Vector3.new(),
                        uncertainty = CONFIG.INITIAL_UNCERTAINTY,
                        lastVelocity= mVel,
                        lastTime    = tick()
                    }
                end
                local now = tick()
                local tdelta = now - state.lastTime
                if tdelta > 0 then
                    local mAccel       = (mVel - state.lastVelocity) / tdelta
                    local predVel      = state.velocity + state.acceleration * tdelta
                    local velResidual  = mVel - predVel
                    local kg           = state.uncertainty / (state.uncertainty + CONFIG.MEASUREMENT_NOISE)
                    state.velocity     = predVel + velResidual * kg
                    state.uncertainty  = (1-kg) * state.uncertainty + CONFIG.PROCESS_NOISE
                    state.acceleration = state.acceleration + (mAccel - state.acceleration) * 0.3
                    state.lastVelocity = mVel
                    state.lastTime     = now
                end
                targetKalman[targetRoot] = state

                local dist  = lr and (targetRoot.Position - lr.Position).Magnitude or 0
                local nDist = math.min(dist / CONFIG.BASE_DISTANCE, 3)
                local mult  = math.clamp(1 + (math.exp(nDist*0.5)-1)*0.4, 1, CONFIG.MAX_MULTIPLIER)
                local predT = CONFIG.PREDICTION_FACTOR * mult
                predictedPos = targetRoot.Position
                             + state.velocity     * predT
                             + state.acceleration * (predT*predT*0.5)
            end

            local targetCF   = CFrame.new(Camera.CFrame.Position, predictedPos)
            local curLook    = Camera.CFrame.LookVector
            local desiredLook= (predictedPos - Camera.CFrame.Position).Unit
            local angleErr   = math.acos(math.clamp(curLook:Dot(desiredLook), -1, 1))

            pidIntegral  = math.clamp(pidIntegral + angleErr*dt, -0.3, 0.3)
            local deriv  = (angleErr - prevError) / dt
            prevError    = angleErr
            local pidOut = 0.020*angleErr + 0.0002*pidIntegral + 0.006*deriv
            local ff     = CONFIG.PREDICTION_ENABLED and targetRoot and targetRoot:IsA("BasePart")
                           and (0.007 * targetRoot.Velocity.Magnitude) or 0
            local raw    = math.clamp(pidOut + ff, 0, 1)
            filteredOutput = raw  -- no extra smoothing (smoothness handled by lerp below)

            if CONFIG.INSTANT_SNAP then
                Camera.CFrame = targetCF
            else
                Camera.CFrame = Camera.CFrame:Lerp(targetCF, math.clamp(CONFIG.SMOOTHNESS, 0.01, 1))
            end

            -- Triggerbot
            if triggerbotEnabled and math.deg(angleErr) < CONFIG.TRIGGERBOT_ANGLE then
                task.delay(CONFIG.TRIGGERBOT_DELAY, function()
                    local m = LocalPlayer:GetMouse()
                    local vim = pcall(function() return game:GetService("VirtualInputManager") end)
                    if vim then
                        local vs = game:GetService("VirtualInputManager")
                        vs:SendMouseButtonEvent(m.X, m.Y, 0, true,  game, 0)
                        task.wait(0.01)
                        vs:SendMouseButtonEvent(m.X, m.Y, 0, false, game, 0)
                    end
                end)
            end
        end
    end
end)


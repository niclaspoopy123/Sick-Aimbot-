-- Threat Indicators
local function removeThreatIndicator(player)
    if threatIndicators[player] then threatIndicators[player]:Destroy(); threatIndicators[player] = nil end
end

local function createOrUpdateThreat(player, angle)
    local ind = threatIndicators[player]
    if not ind then
        ind = Instance.new("Frame", screenGui)
        ind.Size = UDim2.new(0,CONFIG.THREAT_INDICATOR_SIZE,0,CONFIG.THREAT_INDICATOR_SIZE)
        ind.AnchorPoint = Vector2.new(0.5,0.5)
        ind.BackgroundColor3 = CONFIG.THREAT_INDICATOR_COLOR
        ind.BorderSizePixel = 0
        ind.ZIndex = 10
        corner(ind, UDim.new(0,4))
        local arrow = Instance.new("TextLabel", ind)
        arrow.Size = UDim2.new(1,0,1,0)
        arrow.BackgroundTransparency = 1
        arrow.TextColor3 = Color3.new(1,1,1)
        arrow.TextSize = 18
        arrow.Font = Enum.Font.GothamBold
        arrow.Name = "Arrow"
        threatIndicators[player] = ind
    end
    local vp = Camera.ViewportSize
    ind.Position = UDim2.new(0, vp.X/2 + math.cos(angle)*CONFIG.THREAT_INDICATOR_DIST,
                              0, vp.Y/2 + math.sin(angle)*CONFIG.THREAT_INDICATOR_DIST)
    local arrow = ind:FindFirstChild("Arrow")
    if arrow then
        local deg = math.deg(angle)
        arrow.Text = (deg > -90 and deg < 90) and "◄" or "►"
        arrow.Rotation = deg
    end
    ind.Visible = true
end

local function scan360()
    if not threatEnabled then
        for p in pairs(threatIndicators) do removeThreatIndicator(p) end
        return
    end
    local now = tick()
    if now - lastThreatScan < CONFIG.THREAT_SCAN_INTERVAL then return end
    lastThreatScan = now

    local lc = LocalPlayer.Character
    if not lc then return end
    local lr = lc.PrimaryPart or lc:FindFirstChild("HumanoidRootPart")
    if not lr then return end

    local found = {}
    for player in pairs(playerConnections) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        local hum  = char:FindFirstChildOfClass("Humanoid")
        local root = char.PrimaryPart or char:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and root then
            local dist = (root.Position - lr.Position).Magnitude
            if dist >= CONFIG.THREAT_MIN_DISTANCE and dist <= CONFIG.THREAT_MAX_DISTANCE then
                local vp = Camera.ViewportSize
                local sc = Vector2.new(vp.X/2, vp.Y/2)
                local sp = Camera:WorldToScreenPoint(root.Position)
                local sp2 = Vector2.new(sp.X, sp.Y)
                if (sp2-sc).Magnitude^2 > fovRadiusSq then
                    local toT = Vector3.new(root.Position.X-lr.Position.X, 0, root.Position.Z-lr.Position.Z).Unit
                    local cr  = Vector3.new(Camera.CFrame.RightVector.X, 0, Camera.CFrame.RightVector.Z).Unit
                    local cf  = Vector3.new(Camera.CFrame.LookVector.X,  0, Camera.CFrame.LookVector.Z).Unit
                    createOrUpdateThreat(player, math.atan2(toT:Dot(cr), toT:Dot(cf)))
                    found[player] = true
                end
            end
        end
    end
    for p in pairs(threatIndicators) do
        if not found[p] then removeThreatIndicator(p) end
    end
end

-- Visibility cache
local function checkVisible(char, targetPart, lc)
    local now = tick()
    local cached = visibilityCache[char]
    if cached and (now - cached.t) < CONFIG.VISIBILITY_CHECK_INTERVAL then return cached.v end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    rp.FilterDescendantsInstances = {lc}
    local dir = (targetPart.Position - Camera.CFrame.Position).Unit
    local res = Workspace:Raycast(Camera.CFrame.Position, dir * CONFIG.MAX_DISTANCE, rp)
    local v = (not res) or (res.Instance and res.Instance:IsDescendantOf(char))
    visibilityCache[char] = {v=v, t=now}
    return v
end

local function inFOV(pos)
    local vp = Camera.ViewportSize
    local sc = Vector2.new(vp.X/2, vp.Y/2)
    local sp, onScreen = Camera:WorldToScreenPoint(pos)
    if not onScreen then return false end
    return (Vector2.new(sp.X, sp.Y) - sc).Magnitude^2 <= fovRadiusSq
end


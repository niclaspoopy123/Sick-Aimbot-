--// Core Feature Functions

-- Hitbox
local function removeHitbox(player)
    local parts = playerHitboxParts[player]
    if not parts then return end
    for _, p in ipairs(parts) do p:Destroy() end
    playerHitboxParts[player] = nil
end

local function applyHitbox(player)
    if not hitboxEnabled or player == LocalPlayer then return end
    removeHitbox(player)
    local char = player.Character
    if not char then return end
    playerHitboxParts[player] = {}
    for _, pname in ipairs(CONFIG.HITBOX_PARTS) do
        local orig = char:FindFirstChild(pname)
        if orig and orig:IsA("BasePart") then
            local ex = Instance.new("Part")
            ex.Name = "s_ick_HBX"
            ex.Size = orig.Size + Vector3.new(CONFIG.HITBOX_SIZE,CONFIG.HITBOX_SIZE,CONFIG.HITBOX_SIZE)
            ex.CanCollide = false; ex.CanTouch = false; ex.CanQuery = true
            ex.Transparency = 1; ex.Anchored = false
            ex.Parent = char
            local weld = Instance.new("WeldConstraint", ex)
            weld.Part0 = ex; weld.Part1 = orig
            table.insert(playerHitboxParts[player], ex)
        end
    end
end

-- Highlight & pulse
local function removeHighlight(player)
    if pulseTweens[player] then pulseTweens[player]:Cancel(); pulseTweens[player] = nil end
    if playerHighlights[player] then playerHighlights[player]:Destroy(); playerHighlights[player] = nil end
end

local function applyHighlight(player)
    if not highlightEnabled or player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    removeHighlight(player)
    local hl = Instance.new("Highlight", char)
    hl.FillColor    = CONFIG.HIGHLIGHT_FILL_COLOR
    hl.OutlineColor = CONFIG.HIGHLIGHT_OUTLINE_COLOR
    hl.DepthMode    = CONFIG.HIGHLIGHT_DEPTH_MODE
    hl.FillTransparency    = 1
    hl.OutlineTransparency = 1
    playerHighlights[player] = hl
    tween(hl, {FillTransparency=CONFIG.HIGHLIGHT_FILL_TRANS, OutlineTransparency=CONFIG.HIGHLIGHT_OUTLINE_TRANS}, 0.4)

    local function pulse()
        if not hl or not hl.Parent then return end
        local t1 = tween(hl, {FillTransparency=CONFIG.HIGHLIGHT_PULSE_MIN}, CONFIG.HIGHLIGHT_PULSE_DURATION/2)
        pulseTweens[player] = t1
        t1.Completed:Connect(function()
            if not hl or not hl.Parent then return end
            local t2 = tween(hl, {FillTransparency=CONFIG.HIGHLIGHT_PULSE_MAX}, CONFIG.HIGHLIGHT_PULSE_DURATION/2)
            pulseTweens[player] = t2
            t2.Completed:Connect(pulse)
        end)
    end
    pulse()
end


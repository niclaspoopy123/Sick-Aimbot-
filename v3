local function switchTab(name)
    activeTab = name
    for n, p in pairs(tabPages) do p.Visible = n == name end
    for n, b in pairs(tabBtns) do
        b.TextColor3 = n == name and Color3.new(1,1,1) or Color3.fromRGB(150,150,160)

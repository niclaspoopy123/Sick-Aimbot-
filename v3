--// Utility

local function tween(inst, props, dur, style, dir)
    local info = TweenInfo.new(dur or 0.25, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
    local t = TweenService:Create(inst, info, props)
    t:Play()
    return t
end

local function btnBounce(btn)
    local s = btn.Size
    tween(btn, {Size = s - UDim2.new(0,4,0,4)}, 0.08)
    task.delay(0.08, function() tween(btn, {Size = s}, 0.08) end)
end

local function setBtn(btn, state, onTxt, offTxt)
    btn.Text = state and onTxt or offTxt
    btn.BackgroundColor3 = state and Color3.fromRGB(210,60,60) or Color3.fromRGB(70,70,82)
end

local function corner(inst, radius)
    local c = Instance.new("UICorner", inst)
    c.CornerRadius = radius or UDim.new(0,6)
    return c
end

local function stroke(inst, color, thick)
    local s = Instance.new("UIStroke", inst)
    s.Color = color or Color3.fromRGB(60,60,70)
    s.Thickness = thick or 1
    return s
end

local function hsvToColor(h)
    return Color3.fromHSV(h, 1, 1)
end


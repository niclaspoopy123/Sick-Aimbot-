    end
    updatePlayerList()
end

local function onPlayerRemoving(player)
    removeHighlight(player)
    removeHitbox(player)
    removeESP(player)
    removeThreatIndicator(player)
    if playerConnections[player] then
        for _, c in pairs(playerConnections[player]) do c:Disconnect() end
        playerConnections[player] = nil
    end
    if player.Character then
        visibilityCache[player.Character] = nil
        local root = player.Character.PrimaryPart or player.Character:FindFirstChild("HumanoidRootPart")
        if root then targetKalman[root] = nil end
    end
    if stickyTarget == player then
        stickyTarget = nil
        stickyLbl.Text = "  Locked: None"
    end
    updatePlayerList()
end


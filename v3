local function makeToggleBtn(parent, name, text, yPos)
    local btn = Instance.new("TextButton", parent)
    btn.Name = name
    btn.Size = UDim2.new(1, -20, 0, 34)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.Font = Enum.Font.GothamSemibold

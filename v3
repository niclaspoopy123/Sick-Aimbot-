    btn.TextColor3 = Color3.new(1,1,1)
    btn.BackgroundColor3 = Color3.fromRGB(70,70,82)
    btn.Text = text
    corner(btn)
    return btn
end

local function makeSlider(parent, label, minV, maxV, defV, yPos, cb)
    local ctr = Instance.new("Frame", parent)
    ctr.Name = label.."_Slider"
    ctr.Size = UDim2.new(1, -20, 0, 48)
    ctr.Position = UDim2.new(0, 10, 0, yPos)
    ctr.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", ctr)
    lbl.Size = UDim2.new(0.6, 0, 0, 18)
    lbl.Position = UDim2.new(0,0,0,0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextColor3 = Color3.fromRGB(210,210,210)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = label

    local valLbl = Instance.new("TextLabel", ctr)
    valLbl.Size = UDim2.new(0.4, -5, 0, 18)
    valLbl.Position = UDim2.new(0.6, 5, 0, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.Font = Enum.Font.Gotham
    valLbl.TextSize = 13
    valLbl.TextColor3 = Color3.fromRGB(180,180,180)
    valLbl.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame", ctr)
    track.Size = UDim2.new(1, 0, 0, 7)
    track.Position = UDim2.new(0, 0, 0, 26)
    track.BackgroundColor3 = Color3.fromRGB(22,22,30)
    corner(track, UDim.new(1,0))

    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3 = Color3.fromRGB(210,55,55)
    corner(fill, UDim.new(1,0))

    local handle = Instance.new("TextButton", track)
    handle.Size = UDim2.new(0, 15, 0, 15)
    handle.AnchorPoint = Vector2.new(0.5, 0.5)
    handle.BackgroundColor3 = Color3.new(1,1,1)
    handle.Text = ""
    handle.ZIndex = 3
    corner(handle, UDim.new(1,0))
    stroke(handle, Color3.fromRGB(90,90,100))

    local function update(pct)
        pct = math.clamp(pct, 0, 1)
        handle.Position = UDim2.new(pct, 0, 0.5, 0)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        local v = minV + (maxV - minV) * pct
        valLbl.Text = string.format("%.2f", v)
        if cb then cb(v) end
    end

    update((defV - minV) / (maxV - minV))

    handle.MouseButton1Down:Connect(function()
        local mc, uc
        mc = UserInputService.InputChanged:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
                local mx = UserInputService:GetMouseLocation().X
                local pct = (mx - track.AbsolutePosition.X) / track.AbsoluteSize.X
                update(pct)
            end
        end)
        uc = UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                mc:Disconnect(); uc:Disconnect()
            end
        end)
    end)
    return ctr
end

local function makeSectionLabel(parent, text, yPos)
    local lbl = Instance.new("TextLabel", parent)
    lbl.Size = UDim2.new(1, -20, 0, 20)
    lbl.Position = UDim2.new(0, 10, 0, yPos)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.TextColor3 = Color3.fromRGB(160,160,170)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = "  " .. string.upper(text)
    return lbl
end

